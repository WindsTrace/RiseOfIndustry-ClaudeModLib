// ClaudeModLib theme. Edit, then press "Reload theme" in the ClaudeModLib panel (no restart needed).
// Other looks: copy a file from config\presets\ over this one.
// Colours: "#RRGGBB" or "#RRGGBBAA" (AA = opacity, FF = solid).
// Surfaces ("window", "titleBar", "sectionHeader", "box", "button", "buttonHover", "buttonActive", "progressBackground"):
//   flat colour:            { "color": "#F1EBDCFF" }
//   flat colour + outline:  { "color": "#F7F2E7FF", "borderColor": "#C87A06FF", "borderWidth": 2 }
//   game sprite + tint:     { "sprite": "<name from claudemodlib_ui_dump.txt>", "tint": "#FFFFFFFF" }   (keeps 9-slice border)
// fonts / boldFonts: OS font names; later names fill in missing glyphs (Bahnschrift SemiCondensed ~ the game's
// condensed Oswald for Latin, YaHei for Chinese). boldFonts must be a real bold/semibold face: emphasis never uses
// Unity's synthetic bold, which looks crude.
{
  "name": "Native (cream / orange)",
  "fonts":     [ "Bahnschrift SemiCondensed", "Bahnschrift", "Microsoft YaHei", "SimHei", "Arial" ],
  "boldFonts": [ "Bahnschrift SemiBold SemiConden", "Bahnschrift SemiBold", "Microsoft YaHei", "SimHei", "Arial" ],
  "fontSize": 14,
  "titleBarHeight": 30,

  "window":             { "color": "#F1EBDCFF" },
  "titleBar":           { "color": "#3A2B20FF" },
  "sectionHeader":      { "color": "#C87A06FF" },
  "box":                { "color": "#F7F2E7FF", "borderColor": "#C87A06FF", "borderWidth": 2 },
  "button":             { "color": "#C87A06FF" },
  "buttonHover":        { "color": "#DC8E1CFF" },
  "buttonActive":       { "color": "#A86504FF" },
  "progressBackground": { "color": "#9F9C91FF" },

  "titleText":         "#F1EBDCFF",
  "sectionHeaderText": "#F1EBDCFF",
  "text":              "#4A4036FF",
  "subtext":           "#86837BFF",
  "header":            "#C87A06FF",
  "buttonText":        "#F7F2E7FF",

  "switchOn":   "#5E8C31FF",
  "switchOff":  "#B5452FFF",
  "switchKnob": "#F7F2E7FF",

  // status colours used by mods (Ui.Green / Red / Yellow / Blue) - darker, for the cream background
  "good": "#4E8A2EFF",
  "bad":  "#B3412EFF",
  "warn": "#C87A06FF",
  "info": "#3D7AA8FF"
}
